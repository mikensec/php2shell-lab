# ============================================================================
# PHP version under test — CVE-2026-109618 / CVE-2026-109619 ("php2shell")
# Published 2026-10-21.  session.upload_progress use-after-free -> RCE.
#
#   Fixed in:  PHP 8.5.12, 8.4.27, 8.3.36, 8.2.35
#   A build BELOW the fix for its branch is VULNERABLE; >= the fix is patched.
#   (8.1 / 8.0 and earlier are EOL — no official fix. Confirm on php.net.)
# ============================================================================

# Exact, pinned tag so the build is reproducible. Floating tags like
# "8.3-apache" now resolve to the PATCHED 8.3.36 — do not use them to repro.
#
# VULNERABLE by design: 8.3.35 is the last 8.3 release before the 8.3.36 fix.
# To confirm the issue is CLOSED instead, set this to 8.3.36-apache.
PHP_TAG=8.3.35-apache

# Fixed-in version for the branch above. `./lab.sh version` compares the
# running PHP against this and prints VULNERABLE or PATCHED.
FIXED_IN=8.3.36

# WordPress scenario image (./lab.sh up wordpress).
# The wordpress:*-php8.3 tags float to the latest PHP 8.3.x, which is now the
# PATCHED 8.3.36. To keep the WP victim vulnerable, pin by DIGEST to an image
# still carrying PHP <= 8.3.35 — see the "WordPress" note in the README.
WP_TAG=6.6-php8.3-apache
